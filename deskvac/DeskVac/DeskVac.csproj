<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 1809+ – wymagane przez natywne powiadomienia z przyciskami -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- pozwala kompilować projekt także na Linux/macOS (CI, kontrola składni) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DeskVac</AssemblyName>
    <RootNamespace>DeskVac</RootNamespace>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\DeskVac.ico</ApplicationIcon>
    <Product>DeskVac</Product>
    <Description>Robot-odkurzacz, który sprząta pulpit Windows do folderu.</Description>
    <SatelliteResourceLanguages>pl;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- projekty WPF nie dodają System.IO do niejawnych usingów -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- odtwarzanie i miksowanie dźwięku (MIT) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- natywne powiadomienia Windows z przyciskami (MIT) -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- dźwięki wkompilowane w .exe; generuje je deskvac/tools/make_sounds.py -->
    <EmbeddedResource Include="Assets\Sounds\*.wav" />
  </ItemGroup>

</Project>
