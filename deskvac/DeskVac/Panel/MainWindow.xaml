<Window x:Class="DeskVac.Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskVac.Panel"
        Title="DeskVac – odkurzacz pulpitu"
        Width="400" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True">
  <StackPanel Margin="18,16,18,18">

    <!-- nagłówek -->
    <DockPanel Margin="0,0,0,14">
      <Grid Width="38" Height="38" Margin="0,0,12,0" DockPanel.Dock="Left">
        <Ellipse Fill="{DynamicResource LogoBg}" Stroke="{DynamicResource Accent}" StrokeThickness="2"/>
        <Ellipse Width="13" Height="13" Fill="{DynamicResource LogoDot}" Margin="0,0,6,0"/>
      </Grid>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="DeskVac" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="StatusText" Text="W stacji dokującej" Foreground="{DynamicResource Muted}" FontSize="12"/>
      </StackPanel>
    </DockPanel>

    <!-- mapa -->
    <Border CornerRadius="12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Height="190">
      <local:MiniMap x:Name="Map"/>
    </Border>

    <!-- bateria -->
    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="52"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Bateria" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
      <Border x:Name="BatteryTrack" Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource Track}" VerticalAlignment="Center">
        <Border x:Name="BatteryFill" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Accent}" Width="0"/>
      </Border>
      <TextBlock x:Name="BatteryText" Grid.Column="2" Text="100%" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    </Grid>

    <!-- pojemnik -->
    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="52"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Pojemnik" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
      <Border x:Name="BinTrack" Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource Track}" VerticalAlignment="Center">
        <Border x:Name="BinFill" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource BinFill}" Width="0"/>
      </Border>
      <TextBlock x:Name="BinText" Grid.Column="2" Text="0%" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    </Grid>

    <!-- segregacja według treści -->
    <Border Margin="0,10,0,0" CornerRadius="10" Padding="12,8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
      <DockPanel>
        <Button x:Name="SegButton" DockPanel.Dock="Right" Content="Segreguj" Style="{StaticResource PillButton}" Padding="12,5" Margin="10,0,0,0"
                VerticalAlignment="Center" Click="OnSegregate" ToolTip="Czyta treść dokumentów i układa je w podfoldery tematyczne (Faktury, Umowy…)"/>
        <StackPanel>
          <TextBlock Text="SEGREGACJA (beta)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
          <Border x:Name="SegTrack" Height="6" CornerRadius="3" Background="{DynamicResource Track}">
            <Border x:Name="SegFill" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Accent}" Width="0"/>
          </Border>
          <TextBlock x:Name="SegText" Text="Gotowa" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- statystyki -->
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Card}" CornerRadius="12" Padding="14,10" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="CountText" Text="0" FontSize="24" FontWeight="Bold"/>
          <TextBlock x:Name="CountSub" Text="zebranych elementów" Foreground="{DynamicResource Muted}" FontSize="12"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource Card}" CornerRadius="12" Padding="14,10" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="SizeText" Text="0 B" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="przeniesione do folderu" Foreground="{DynamicResource Muted}" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- co sprzątać -->
    <DockPanel Margin="0,14,0,0">
      <TextBlock Text="CO SPRZĄTAĆ" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
      <ComboBox x:Name="TargetBox" FontSize="13" Padding="8,5"/>
    </DockPanel>

    <!-- sterowanie -->
    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="StartButton" Content="▶  Sprzątaj" Style="{StaticResource AccentButton}" Click="OnStart"/>
      <Button x:Name="PauseButton" Grid.Column="2" Content="Pauza" Style="{StaticResource PillButton}" Click="OnPause" IsEnabled="False"/>
      <Button x:Name="StopButton" Grid.Column="4" Content="Do bazy" Style="{StaticResource PillButton}" Click="OnStop" IsEnabled="False"/>
    </Grid>

    <!-- ustawienia -->
    <Border Background="{DynamicResource Card}" CornerRadius="12" Padding="14,12" Margin="0,14,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="CO ZBIERAĆ" Style="{StaticResource Caption}"/>
        <WrapPanel>
          <CheckBox x:Name="ShortcutsBox" Content="Skróty"/>
          <CheckBox x:Name="FilesBox" Content="Pliki"/>
          <CheckBox x:Name="FoldersBox" Content="Foldery"/>
        </WrapPanel>
        <CheckBox x:Name="MinimizeBox" Content="Zminimalizuj okna na czas sprzątania" Margin="0,4,0,6"/>
        <DockPanel>
          <CheckBox x:Name="SoundBox" Content="Dźwięki" Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- chronione: przeciągnij tu ikony z pulpitu -->
    <Border x:Name="ProtectDrop" Margin="0,14,0,0" CornerRadius="12" Padding="14,10" AllowDrop="True" Cursor="Hand"
            Background="{DynamicResource DropBg}" BorderBrush="{DynamicResource DropBorder}" BorderThickness="1"
            ToolTip="Przeciągnij tu ikony z pulpitu, żeby robot ich nie ruszał. Kliknij, aby zobaczyć listę.">
      <DockPanel>
        <TextBlock Text="🛡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
        <StackPanel>
          <TextBlock x:Name="ProtectedCountText" Text="Chronione: 0" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock x:Name="ProtectDropHint" Text="Przeciągnij tu ikony z pulpitu – robot ich nie ruszy" Foreground="{DynamicResource Muted}" FontSize="11"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- dół -->
    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Button x:Name="UndoButton" Content="↶  Cofnij" Style="{StaticResource PillButton}" Click="OnUndo" Padding="8,9"/>
      <Button Grid.Column="2" Content="Folder" Style="{StaticResource PillButton}" Click="OnOpenFolder" Padding="8,9"/>
      <Button Grid.Column="4" Content="⚙  Ustawienia" Style="{StaticResource PillButton}" Click="OnSettings" Padding="8,9"/>
    </Grid>

    <TextBlock x:Name="ProblemText" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
    <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
               Text="Nic nie jest usuwane. Robot przenosi elementy do folderu „Zebrane z pulpitu”, a każde sprzątanie można cofnąć. Szybki start: kliknij 3× w robota przy stacji."/>
    <TextBlock x:Name="AuthorText" Foreground="{DynamicResource Muted}" FontSize="10" Opacity="0.75" Margin="0,8,0,0" HorizontalAlignment="Right"/>
  </StackPanel>
</Window>
