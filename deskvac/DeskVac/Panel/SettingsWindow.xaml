<Window x:Class="DeskVac.Panel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskVac – ustawienia"
        Width="520" Height="760" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,8"/>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#10141A"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="#2F3640"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#12161B" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="18,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource AccentButton}" Click="OnSave" MinWidth="110"/>
        <Button DockPanel.Dock="Right" Content="Anuluj" Style="{StaticResource PillButton}" Click="OnCancel" Margin="0,0,8,0" MinWidth="90"/>
        <TextBlock x:Name="SaveInfo" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="18,16,18,6">

        <!-- OGÓLNE -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Ogólne" Style="{StaticResource Header}"/>
            <CheckBox x:Name="AutostartBox" Content="Uruchamiaj DeskVac razem z Windows (w tle)"/>
            <CheckBox x:Name="CloseToTrayBox" Content="Zamknięcie panelu chowa DeskVac do zasobnika"/>
            <CheckBox x:Name="ShowRobotBox" Content="Pokazuj robota stojącego przy stacji na pulpicie"/>
          </StackPanel>
        </Border>

        <!-- PRZYPOMNIENIA -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Przypomnienia o sprzątaniu" Style="{StaticResource Header}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <CheckBox x:Name="RemindStartupBox" Content="Po uruchomieniu komputera, po" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBox x:Name="StartupDelayBox" Style="{StaticResource Field}" Width="40"/>
              <TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="RemindDailyBox" Content="Codziennie o godzinach:" Margin="0,4,0,6"/>
            <WrapPanel x:Name="TimesPanel" Margin="22,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="22,0,0,8">
              <TextBox x:Name="NewTimeBox" Style="{StaticResource Field}" Width="70" Text="12:00"/>
              <Button Content="+ Dodaj godzinę" Style="{StaticResource PillButton}" Padding="10,5" Margin="8,0,0,0" Click="OnAddTime"/>
            </StackPanel>
            <TextBlock Text="W dni:" Style="{StaticResource Hint}" Margin="22,0,0,4"/>
            <WrapPanel x:Name="ReminderDaysPanel" Margin="22,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Nie przypominaj, gdy do sprzątnięcia jest mniej niż" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="MinItemsBox" Style="{StaticResource Field}" Width="40"/>
              <TextBlock Text="elementów" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Pokaż przykładowe powiadomienie" Style="{StaticResource PillButton}" Padding="10,6" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnTestReminder"/>
          </StackPanel>
        </Border>

        <!-- AUTOMATYCZNE -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Sprzątanie automatyczne" Style="{StaticResource Header}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <CheckBox x:Name="AutoCleanBox" Content="Sprzątaj automatycznie, bez pytania, o godzinie" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBox x:Name="AutoTimeBox" Style="{StaticResource Field}" Width="60"/>
            </StackPanel>
            <TextBlock Text="W dni:" Style="{StaticResource Hint}" Margin="22,0,0,4"/>
            <WrapPanel x:Name="AutoDaysPanel" Margin="22,0,0,8"/>
            <CheckBox x:Name="AutoQuietBox" Content="Bez dźwięku (sprzątanie w tle nie przeszkadza w pracy)"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Robot sprząta pod oknami programów – nie zabiera fokusu i nie minimalizuje okien. Dostaniesz powiadomienie, że ruszył (z przyciskiem „Zatrzymaj”) i że skończył (z przyciskiem „Cofnij”). Podczas prezentacji, gry lub filmu na pełnym ekranie sprzątanie czeka."/>
          </StackPanel>
        </Border>

        <!-- CHRONIONE -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Chronione elementy – „Nie odkurzaj!”" Style="{StaticResource Header}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Na pulpicie: prawy przycisk na ikonie → Pokaż więcej opcji → „DeskVac: Nie odkurzaj! / Pozwól odkurzać”. Działa też dla wielu zaznaczonych ikon naraz."/>
            <ListBox x:Name="ProtectedList" Height="130" Background="#10141A" Foreground="{StaticResource Text}"
                     BorderBrush="#2F3640" SelectionMode="Extended" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
              <Button Content="Dodaj plik…" Style="{StaticResource PillButton}" Padding="10,5" Click="OnAddFile"/>
              <Button Content="Dodaj folder…" Style="{StaticResource PillButton}" Padding="10,5" Margin="8,0,0,0" Click="OnAddFolder"/>
              <Button Content="Usuń zaznaczone" Style="{StaticResource PillButton}" Padding="10,5" Margin="8,0,0,0" Click="OnRemoveProtected"/>
            </StackPanel>
            <TextBlock Text="Nie ruszaj też elementów o nazwach (oddzielone przecinkami):" Style="{StaticResource Hint}"/>
            <TextBox x:Name="ExclusionsBox" Style="{StaticResource Field}"/>
            <CheckBox x:Name="MenuOnlyDesktopBox" Content="Pozycja w menu kontekstowym tylko dla elementów pulpitu" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

        <!-- KALIBRACJA -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Namierzanie ikon" Style="{StaticResource Header}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Pozycje ikon są odczytywane wprost z Eksploratora, na wszystkich monitorach i przy każdym skalowaniu. Gdyby ramki mimo to były przesunięte, popraw je tutaj (w pikselach przy 100%)."/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Przesunięcie X:" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="OffsetXBox" Style="{StaticResource Field}" Width="50"/>
              <TextBlock Text="Y:" VerticalAlignment="Center" Margin="14,0,6,0"/>
              <TextBox x:Name="OffsetYBox" Style="{StaticResource Field}" Width="50"/>
              <Button Content="Test namierzania" Style="{StaticResource PillButton}" Padding="10,5" Margin="14,0,0,0" Click="OnPreview"/>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
