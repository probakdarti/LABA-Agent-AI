<Window x:Class="DeskVac.Panel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskVac – ustawienia"
        Width="520" Height="760" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,8"/>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="18,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource AccentButton}" Click="OnSave" MinWidth="110"/>
        <Button DockPanel.Dock="Right" Content="Anuluj" Style="{StaticResource PillButton}" Click="OnCancel" Margin="0,0,8,0" MinWidth="90"/>
        <TextBlock x:Name="SaveInfo" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="18,16,18,6">

        <!-- OGÓLNE -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Ogólne" Style="{StaticResource Header}"/>
            <CheckBox x:Name="AutostartBox" Content="Uruchamiaj DeskVac razem z Windows (w tle)"/>
            <CheckBox x:Name="CloseToTrayBox" Content="Zamknięcie panelu chowa DeskVac do zasobnika"/>
            <CheckBox x:Name="ShowRobotBox" Content="Pokazuj robota stojącego przy stacji na pulpicie"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
              <TextBlock Text="Motyw:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="ThemeBox" Width="150" SelectedIndex="0">
                <ComboBoxItem Content="Ciemny" Tag="dark"/>
                <ComboBoxItem Content="Jasny" Tag="light"/>
                <ComboBoxItem Content="Systemowy (jak w Windows)" Tag="system"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock Text="Pojemnik robota mieści" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="BinCapacityBox" Style="{StaticResource Field}" Width="50"/>
              <TextBlock Text="elementów z pulpitu (10–100)" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Gdy pojemnik się zapełni, robot wraca do stacji, opróżnia go, szybko się ładuje i sprząta pulpit dalej."/>
            <CheckBox x:Name="QuickAllBox" Content="Potrójne kliknięcie w robota sprząta też foldery „razem z pulpitem” (domyślnie tylko pulpit)"/>
          </StackPanel>
        </Border>

        <!-- PRZYPOMNIENIA -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Przypomnienia o sprzątaniu" Style="{StaticResource Header}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <CheckBox x:Name="RemindStartupBox" Content="Po uruchomieniu komputera, po" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBox x:Name="StartupDelayBox" Style="{StaticResource Field}" Width="40"/>
              <TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="RemindDailyBox" Content="Codziennie o godzinach:" Margin="0,4,0,6"/>
            <WrapPanel x:Name="TimesPanel" Margin="22,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="22,0,0,8">
              <TextBox x:Name="NewTimeBox" Style="{StaticResource Field}" Width="70" Text="12:00"/>
              <Button Content="+ Dodaj godzinę" Style="{StaticResource PillButton}" Padding="10,5" Margin="8,0,0,0" Click="OnAddTime"/>
            </StackPanel>
            <TextBlock Text="W dni:" Style="{StaticResource Hint}" Margin="22,0,0,4"/>
            <WrapPanel x:Name="ReminderDaysPanel" Margin="22,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Nie przypominaj, gdy do sprzątnięcia jest mniej niż" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="MinItemsBox" Style="{StaticResource Field}" Width="40"/>
              <TextBlock Text="elementów" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Pokaż przykładowe powiadomienie" Style="{StaticResource PillButton}" Padding="10,6" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnTestReminder"/>
          </StackPanel>
        </Border>

        <!-- AUTOMATYCZNE -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Sprzątanie automatyczne" Style="{StaticResource Header}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <CheckBox x:Name="AutoCleanBox" Content="Sprzątaj automatycznie, bez pytania, o godzinie" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBox x:Name="AutoTimeBox" Style="{StaticResource Field}" Width="60"/>
            </StackPanel>
            <TextBlock Text="W dni:" Style="{StaticResource Hint}" Margin="22,0,0,4"/>
            <WrapPanel x:Name="AutoDaysPanel" Margin="22,0,0,8"/>
            <CheckBox x:Name="AutoQuietBox" Content="Bez dźwięku (sprzątanie w tle nie przeszkadza w pracy)"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Robot sprząta pod oknami programów – nie zabiera fokusu i nie minimalizuje okien. Dostaniesz powiadomienie, że ruszył (z przyciskiem „Zatrzymaj”) i że skończył (z przyciskiem „Cofnij”). Podczas prezentacji, gry lub filmu na pełnym ekranie sprzątanie czeka."/>
          </StackPanel>
        </Border>

        <!-- SPRZĄTANE FOLDERY -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Sprzątane foldery" Style="{StaticResource Header}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Robot porządkuje te foldery na miejscu: luźne pliki trafiają do podfolderów wg typu i tematu (np. Pobrane\PDF\Faktury), luźne podfoldery do „Foldery”, identyczne kopie do „Duplikaty”. Nic nie jest usuwane, każde sprzątanie można cofnąć. Przed pierwszym sprzątaniem folderu zobaczysz podgląd."/>
            <StackPanel x:Name="FoldersPanel"/>
            <WrapPanel Margin="0,6,0,0">
              <Button Content="+ Pobrane" Style="{StaticResource PillButton}" Padding="10,5" Margin="0,0,8,6" Click="OnAddDownloads"/>
              <Button Content="+ Dokumenty" Style="{StaticResource PillButton}" Padding="10,5" Margin="0,0,8,6" Click="OnAddDocuments"/>
              <Button Content="+ Obrazy" Style="{StaticResource PillButton}" Padding="10,5" Margin="0,0,8,6" Click="OnAddPictures"/>
              <Button Content="+ Inny folder…" Style="{StaticResource PillButton}" Padding="10,5" Margin="0,0,8,6" Click="OnAddOtherFolder"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Szybciej: prawy przycisk na dowolnym folderze → Pokaż więcej opcji → „DeskVac: Posprzątaj ten folder” albo „Sprzątaj ten folder regularnie”."/>
          </StackPanel>
        </Border>

        <!-- SEGREGACJA -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Segregacja według treści (beta)" Style="{StaticResource Header}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Robot czyta treść dokumentów (PDF, Word, Excel, PowerPoint, teksty) już posortowanych wg typu i układa je w podfoldery: Faktury, Umowy, Wyciągi bankowe, Oferty… Wszystko lokalnie na komputerze, bez internetu i bez AI. Gdy treść nie daje pewnej odpowiedzi, plik zostaje na miejscu."/>
            <CheckBox x:Name="SegEnabledBox" Content="Włącz segregację według treści"/>
            <CheckBox x:Name="SegAutoBox" Content="Segreguj automatycznie w tle po każdym sprzątaniu" Margin="22,0,14,6"/>
            <CheckBox x:Name="SegOcrBox" Content="Czytaj skany PDF (OCR wbudowany w Windows)" Margin="22,0,14,6"/>
            <CheckBox x:Name="SegImagesBox" Content="Czytaj też zdjęcia (wolniej – przydatne, gdy fotografujesz dokumenty)" Margin="22,0,14,6"/>
            <TextBlock x:Name="OcrStatusText" Style="{StaticResource Hint}" Margin="22,0,0,8"/>
            <Button Content="Segreguj ponownie wszystko (z podglądem)" Style="{StaticResource PillButton}" Padding="10,6"
                    HorizontalAlignment="Left" Click="OnResegregate"/>
          </StackPanel>
        </Border>

        <!-- PORZĄDKOWANIE -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Porządkowanie zebranych" Style="{StaticResource Header}"/>
            <CheckBox x:Name="SortByTypeBox" Content="Dziel zebrane wg typu: Skróty programów, Word, Excel, PDF, Zdjęcia, Filmy…"/>
            <CheckBox x:Name="SortByTopicBox" Content="Podfoldery wg nazwy: Umowy, Faktury, Oferty, Zamówienia, Raporty…" Margin="22,0,14,6"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Np. „Umowa najmu.docx” → Word\Umowy, „Invoice 12.pdf” → PDF\Faktury, „Screenshot.png” → Zdjęcia\Zrzuty ekranu. Słowa rozpoznawane są w wielu językach (umowa, contract, Vertrag, contrat, договор…). Wyłączone = jak dawniej, folder z datą sprzątania."/>
            <Button Content="Posortuj wcześniej zebrane (foldery z datami)" Style="{StaticResource PillButton}" Padding="10,6"
                    HorizontalAlignment="Left" Click="OnReorganize"/>
          </StackPanel>
        </Border>

        <!-- CHRONIONE -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Chronione elementy – „Nie odkurzaj!”" Style="{StaticResource Header}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Przeciągnij ikony z pulpitu na listę poniżej albo: prawy przycisk na ikonie → Pokaż więcej opcji → „Nie odkurzaj!” (i „Pozwól odkurzać!”, żeby zdjąć ochronę). Zmiany działają od razu."/>
            <Grid>
              <ListBox x:Name="ProtectedList" Height="190" Background="{DynamicResource FieldBg}" Foreground="{DynamicResource Text}"
                       BorderBrush="{DynamicResource DropBorder}" BorderThickness="1" SelectionMode="Extended" FontSize="12" AllowDrop="True"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <TextBlock x:Name="ProtectedEmpty" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="13"
                         Text="🛡&#x0a;Przeciągnij tutaj ikony z pulpitu"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
              <Button Content="Dodaj plik…" Style="{StaticResource PillButton}" Padding="10,5" Click="OnAddFile"/>
              <Button Content="Dodaj folder…" Style="{StaticResource PillButton}" Padding="10,5" Margin="8,0,0,0" Click="OnAddFolder"/>
              <Button  Content="Pozwól odkurzać zaznaczone" Style="{StaticResource PillButton}" Padding="10,5" Margin="8,0,0,0" Click="OnRemoveProtected"/>
            </StackPanel>
            <TextBlock Text="Nie ruszaj też elementów o nazwach (oddzielone przecinkami):" Style="{StaticResource Hint}"/>
            <TextBox x:Name="ExclusionsBox" Style="{StaticResource Field}"/>
            <CheckBox x:Name="MenuOnlyDesktopBox" Content="Pozycja w menu kontekstowym tylko dla elementów pulpitu" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

        <!-- KALIBRACJA -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Namierzanie ikon" Style="{StaticResource Header}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Pozycje ikon są odczytywane wprost z Eksploratora, na wszystkich monitorach i przy każdym skalowaniu. Gdyby ramki mimo to były przesunięte, popraw je tutaj (w pikselach przy 100%)."/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Przesunięcie X:" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="OffsetXBox" Style="{StaticResource Field}" Width="50"/>
              <TextBlock Text="Y:" VerticalAlignment="Center" Margin="14,0,6,0"/>
              <TextBox x:Name="OffsetYBox" Style="{StaticResource Field}" Width="50"/>
              <Button Content="Test namierzania" Style="{StaticResource PillButton}" Padding="10,5" Margin="14,0,0,0" Click="OnPreview"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- O PROGRAMIE -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="O programie" Style="{StaticResource Header}"/>
            <TextBlock x:Name="AboutVersion" FontSize="13" Margin="0,0,0,8"/>
            <TextBlock FontSize="13" Margin="0,0,0,2">
              <Run Text="Autor: "/><Run Text="VERME Paweł Robak" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock FontSize="13" Margin="0,0,0,2">
              <Run Text="E-mail: "/><Hyperlink NavigateUri="mailto:pawelrobak@outlook.com" RequestNavigate="OnLink" Foreground="{DynamicResource Accent}">pawelrobak@outlook.com</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="13" Margin="0,0,0,8">
              <Run Text="Telefon: "/><Hyperlink NavigateUri="tel:+48504706334" RequestNavigate="OnLink" Foreground="{DynamicResource Accent}">504 706 334</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="AboutCopyright" Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
